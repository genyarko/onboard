{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/onboard-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/onboard-extension/out/**/*.js"
      ],
      "preLaunchTask": "npm: watch - onboard-extension"
    }
  ]
}